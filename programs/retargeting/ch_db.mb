tcam staging (ingress_port : 9) : {c : 4} [set_choice skip_pipe].
tcam ch_ipv4 (dstAddr : 32) : {dstAddr : 48, port : 9} [fwd nop].
tcam ch_ipv42 (dstAddr : 32) : {dstAddr : 48, port : 9} [fwd nop].
tcam ch_ethernet (dstAddr : 48) : {port : 9} [fwd nop].
tcam ch_ethernet2 (dstAddr : 48) : {port : 9} [fwd nop].
tcam ch_punt (etherType : 16, isValid : 1, version : 4, srcAddr : 32, dstAddr : 32, ttl : 8) : {} [drop nop].
tcam ch_punt2 (etherType : 16, isValid : 1, version : 4, srcAddr : 32, dstAddr : 32, ttl : 8) : {} [drop nop].

tcam db_ipv4 (dstAddr : 32) : {dstAddr : 48, port : 9} [fwd nop]
o--
    ch_ipv4.

tcam db_ipv42 (dstAddr : 32) : {dstAddr : 48, port : 9} [fwd nop]
o--
    ch_ipv4.

tcam db_ethernet (dstAddr : 48) : {port : 9} [fwd nop]
o--
    ch_ethernet.

tcam db_ethernet2 (dstAddr : 48) : {port : 9} [fwd nop]
o--
    ch_ethernet.

tcam db_punt (etherType : 16, isValid : 1, version : 4, srcAddr : 32, dstAddr : 32, ttl : 8) : {} [drop nop]
o--
    ch_punt.

tcam db_punt2 (etherType : 16, isValid : 1, version : 4, srcAddr : 32, dstAddr : 32, ttl : 8) : {} [drop nop]
o--
    ch_punt.