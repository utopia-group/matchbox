tcam ipv4_fib (dstAddr : 32) : {port : 9} [fwd nop].
tcam ipv4_rewrite (dstAddr : 32) : {dstAddr : 48} [rewrite nop].
tcam ad_ethernet (dstAddr : 48) : {port : 9} [fwd nop].
tcam ad_punt (etherType : 16, isValid : 1, version : 4, srcAddr : 32, dstAddr : 32, ttl : 8) : {} [drop nop].

ghost tcam lookup (port : 9, nexthop : 32) : {port : 9, nexthop : 32} [_]
o--
    forall port := enumerate(9), nexthop := unique(32):
        |port, nexthop -> _(port, nexthop)|.

assume lookup : {nexthop : 32 | true} ---> {port : 9}.

tcam nexthop (nexthop : 32) : {port : 9} [set_port drop]
o--
    lookup >>
    delete key port >>
    delete data nexthop >>
    rename _ to set_port >>
    add drop.

assume lookup : {port : 9 | true} ---> {nexthop : 32}.

tcam la_ethernet (dstAddr : 48) : {nexthop : 32} [fwd nop]
o--
    ad_ethernet >> (
        lookup >>
        delete key nexthop >>
        delete data port >>
        rename _ to fwd >>
        add nop
    ).

ghost tcam ipv4 (dstAddr : 32) : {dstAddr : 48, port : 9} [fwd nop]
o--
    ipv4_fib * ipv4_rewrite >>
    rename fwd;rewrite to fwd >>
    rename fwd;nop to nop >>
    rename rewrite;nop to nop >>
    rename nop;rewrite to nop >>
    rename nop;nop to nop.

tcam la_ipv4 (dstAddr : 32) : {dstAddr : 48, nexthop : 32} [fwd nop]
o--
    (
        ipv4 >>
        delete data dstAddr >> (
            lookup >>
            delete key nexthop >>
            delete data port
        )
    ) * (
        ipv4 >>
        delete data port
    ) >>
    rename _;fwd to fwd >>
    rename _;nop to nop.

tcam la_punt (etherType : 16, isValid : 1, version : 4, srcAddr : 32, dstAddr : 32, ttl : 8) : {} [drop nop]
o--
    ad_punt.
