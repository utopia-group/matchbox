tcam nexthop (nexthop : 32) : {port : 9} [set_port drop].
tcam la_ethernet (ethernet.dstAddr : 48) : {nexthop : 32} [fwd nop].
tcam la_ipv4 (dstAddr : 32) : {ethernet.dstAddr : 48, nexthop : 32} [fwd nop].
tcam la_punt (etherType : 16, isValid : 1, version : 4, srcAddr : 32, dstAddr : 32, ttl : 8) : {} [drop nop].

assume la_punt : {etherType : 16, isValid : 1, ttl : 8 | true} ---> {}.

tcam ethernet_validate (etherType : 16, isValid : 1, ttl : 8) : {} [malformed ok]
o--
    la_punt >>
    delete key version >>
    delete key srcAddr >>
    delete key dstAddr >>
    rename drop to malformed >>
    rename nop to ok.

assume la_punt : {version : 4, ttl : 8 | true} ---> {}.

tcam ipv4_validate (version : 4, ttl : 8) : {} [malformed ok]
o--
    la_punt >>
    delete key etherType >>
    delete key isValid >>
    delete key srcAddr >>
    delete key dstAddr >>
    rename drop to malformed >>
    rename nop to ok.

tcam ev_ethernet (ethernet.dstAddr : 48) : {port : 9} [fwd nop]
o--
    la_ethernet >>
    nexthop >>
    rename set_port to fwd >>
    rename drop to nop.

tcam ev_ipv4 (dstAddr : 32) : {ethernet.dstAddr : 48, port : 9} [fwd nop]
o--
    (
        la_ipv4 >>
        delete data ethernet.dstAddr >>
        nexthop
    ) * (
        la_ipv4 >>
        delete data nexthop
    ) >>
    rename set_port;fwd to fwd >>
    rename set_port;nop to nop >>
    rename drop;fwd to nop >>
    rename drop;nop to nop.

assume la_punt : {srcAddr : 32, dstAddr : 32 | true} ---> {}.

tcam acl (eth_srcAddr : 48, eth_dstAddr : 48, ipv4_srcAddr : 32, ipv4_dstAddr : 32) : {} [drop nop]
o--
    la_punt >>
    delete key etherType >>
    delete key isValid >>
    delete key version >>
    delete key ttl >>
    key ipv4_srcAddr := srcAddr >>
    key ipv4_dstAddr := dstAddr >>
    delete key srcAddr >>
    delete key dstAddr >>
    ignore key eth_srcAddr >>
    ignore key eth_dstAddr.
