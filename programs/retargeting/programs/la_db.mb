tcam nexthop (nexthop : 32) : {port : 9} [set_port drop].
tcam la_ethernet (ethernet.dstAddr : 48) : {nexthop : 32} [fwd nop].
tcam la_ipv4 (dstAddr : 32) : {ethernet.dstAddr : 48, nexthop : 32} [fwd nop].
tcam la_punt (etherType : 16, isValid : 1, version : 4, srcAddr : 32, dstAddr : 32, ttl : 8) : {} [drop nop].

tcam db_ipv4 (dstAddr : 32) : {ethernet.dstAddr : 48, port : 9} [fwd nop]
o--
    (
        la_ipv4 >>
        delete data ethernet.dstAddr >>
        nexthop
    ) * (
        la_ipv4 >>
        delete data nexthop
    ) >>
    rename set_port;fwd to fwd >>
    rename set_port;nop to nop >>
    rename drop;fwd to nop >>
    rename drop;nop to nop.

tcam db_ipv42 (dstAddr : 32) : {ethernet.dstAddr : 48, port : 9} [fwd nop]
o--
    db_ipv4.

tcam db_ethernet (ethernet.dstAddr : 48) : {port : 9} [fwd nop]
o--
    la_ethernet >>
    nexthop >>
    rename set_port to fwd >>
    rename drop to nop.

tcam db_ethernet2 (ethernet.dstAddr : 48) : {port : 9} [fwd nop]
o--
    db_ethernet.

tcam db_punt (etherType : 16, isValid : 1, version : 4, srcAddr : 32, dstAddr : 32, ttl : 8) : {} [drop nop]
o--
    la_punt.

tcam db_punt2 (etherType : 16, isValid : 1, version : 4, srcAddr : 32, dstAddr : 32, ttl : 8) : {} [drop nop]
o--
    la_punt.
