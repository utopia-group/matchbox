tcam ipv4 (dstAddr : 32) : {ethernet.dstAddr : 48, port : 9} [fwd nop].
tcam ethernet (ethernet.dstAddr : 48) : {port : 9} [fwd nop].
tcam punt (etherType : 16, isValid : 1, version : 4, srcAddr : 32, dstAddr : 32, ttl : 8) : {} [drop nop].

