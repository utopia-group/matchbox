tcam ipv4 (dstAddr : 32) : {dstAddr : 48, port : 9} [fwd nop].
tcam ethernet (dstAddr : 48) : {port : 9} [fwd nop].
tcam punt (etherType : 16, isValid : 1, version : 4, srcAddr : 32, dstAddr : 32, ttl : 8) : {} [drop].

tcam ipv4_fib (dstAddr : 32) : {port : 9} [fwd nop]
o--
    ipv4 >>
    delete data dstAddr.

tcam ipv4_rewrite (dstAddr : 32) : {dstAddr : 48} [rewrite nop]
o--
    ipv4 >>
    delete data port >>
    rename fwd to rewrite.

tcam ad_ethernet (dstAddr : 48) : {port : 9} [fwd nop]
o--
    ethernet.

tcam ad_punt (etherType : 16, isValid : 1, version : 4, srcAddr : 32, dstAddr : 32, ttl : 8) : {} [drop]
o--
    punt.
