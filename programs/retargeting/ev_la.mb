tcam ethernet_validate (etherType : 16, isValid : 1, ttl : 8) : {} [malformed ok].
tcam ipv4_validate (version : 4, ttl : 8) : {} [malformed ok].
tcam ev_ethernet (dstAddr : 48) : {port : 9} [fwd nop].
tcam ev_ipv4 (dstAddr : 32) : {dstAddr : 48, port : 9} [fwd nop].
tcam acl (eth_srcAddr : 48, eth_dstAddr : 48, ipv4_srcAddr : 32, ipv4_dstAddr : 32) : {} [drop nop].

ghost tcam lookup (port : 9, nexthop : 32) : {port : 9, nexthop : 32} [_]
o--
    forall port := enumerate(9), nexthop := unique(32):
        |port, nexthop -> _(port, nexthop)|.

assume lookup : {nexthop : 32 | true} ---> {port : 9}.

tcam nexthop (nexthop : 32) : {port : 9} [set_port drop]
o--
    lookup >>
    delete key port >>
    delete data nexthop >>
    rename _ to set_port >>
    add drop.

assume lookup : {port : 9 | true} ---> {nexthop : 32}.

tcam la_ethernet (dstAddr : 48) : {nexthop : 32} [fwd nop]
o--
    ev_ethernet >> (
        lookup >>
        delete key nexthop >>
        delete data port >>
        rename _ to fwd >>
        add nop
    ).

tcam la_ipv4 (dstAddr : 32) : {dstAddr : 48, nexthop : 32} [fwd nop]
o--
    (
        ev_ipv4 >>
        delete data dstAddr >> (
            lookup >>
            delete key nexthop >>
            delete data port 
        )
    ) * (
        ev_ipv4 >>
        delete data port
    ) >>
    rename _;fwd to fwd >>
    rename _;nop to nop.

assume acl : {ipv4_srcAddr : 32, ipv4_dstAddr : 32 | true} ---> {}.

tcam la_punt (etherType : 16, isValid : 1, version : 4, srcAddr : 32, dstAddr : 32, ttl : 8) : {} [drop nop]
o--
    ethernet_validate * ipv4_validate * (
        acl >>
        delete key eth_srcAddr >>
        delete key eth_dstAddr >>
        key srcAddr := ipv4_srcAddr >>
        key dstAddr := ipv4_dstAddr >>
        delete key ipv4_srcAddr >>
        delete key ipv4_dstAddr
    ) >>
    rename malformed;malformed;drop to drop >>
    rename malformed;malformed;nop to nop >>
    rename malformed;ok;drop to drop >>
    rename malformed;ok;nop to nop >>
    rename ok;malformed;drop to drop >>
    rename ok;malformed;nop to nop >>
    rename ok;ok;drop to nop >>
    rename ok;ok;nop to nop.
