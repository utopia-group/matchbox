tcam ipv4_fib (dstAddr : 32) : {port : 9} [fwd nop].
tcam ipv4_rewrite (dstAddr : 32) : {dstAddr : 48} [rewrite nop].
tcam ad_ethernet (dstAddr : 48) : {port : 9} [fwd nop].
tcam ad_punt (etherType : 16, isValid : 1, version : 4, srcAddr : 32, dstAddr : 32, ttl : 8) : {} [drop nop].

tcam db_ipv4 (dstAddr : 32) : {dstAddr : 48, port : 9} [fwd nop]
o--
    ipv4_fib * ipv4_rewrite >>
    rename fwd;rewrite to fwd >>
    rename nop;nop to nop >>
    // assumption: cannot only fwd or only rewrite
    rename fwd;nop to nop >>
    rename nop;rewrite to nop.

tcam db_ipv42 (dstAddr : 32) : {dstAddr : 48, port : 9} [fwd nop]
o--
    db_ipv4.

tcam db_ethernet (dstAddr : 48) : {port : 9} [fwd nop]
o--
    ad_ethernet.

tcam db_ethernet2 (dstAddr : 48) : {port : 9} [fwd nop]
o--
    ad_ethernet.

tcam db_punt (etherType : 16, isValid : 1, version : 4, srcAddr : 32, dstAddr : 32, ttl : 8) : {} [drop nop]
o--
    ad_punt.

tcam db_punt2 (etherType : 16, isValid : 1, version : 4, srcAddr : 32, dstAddr : 32, ttl : 8) : {} [drop nop]
o--
    ad_punt.
