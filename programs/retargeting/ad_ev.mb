tcam ipv4_fib (dstAddr : 32) : {port : 9} [fwd nop].
tcam ipv4_rewrite (dstAddr : 32) : {dstAddr : 48} [rewrite nop].
tcam ad_ethernet (dstAddr : 48) : {port : 9} [fwd nop].
tcam ad_punt (etherType : 16, isValid : 1, version : 4, srcAddr : 32, dstAddr : 32, ttl : 8) : {} [drop nop].

assume ad_punt : {etherType : 16, isValid : 1, ttl : 8 | true} ---> {}.

tcam ethernet_validate (etherType : 16, isValid : 1, ttl : 8) : {} [malformed ok]
o--
    ad_punt >>
    delete key version >>
    delete key srcAddr >>
    delete key dstAddr >>
    rename drop to malformed >>
    rename nop to ok.

assume ad_punt : {version : 4, ttl : 8 | true} ---> {}.

tcam ipv4_validate (version : 4, ttl : 8) : {} [malformed ok]
o--
    ad_punt >>
    delete key etherType >>
    delete key isValid >>
    delete key srcAddr >>
    delete key dstAddr >>
    rename drop to malformed >>
    rename nop to ok.

tcam ev_ethernet (dstAddr : 48) : {port : 9} [fwd nop]
o--
    ad_ethernet.

tcam ev_ipv4 (dstAddr : 32) : {dstAddr : 48, port : 9} [fwd nop]
o--
    ipv4_fib * ipv4_rewrite >>
    rename fwd;rewrite to fwd >>
    rename fwd;nop to nop >>
    rename rewrite;nop to nop >>
    rename nop;rewrite to nop >>
    rename nop;nop to nop.

assume ad_punt : {srcAddr : 32, dstAddr : 32 | true} ---> {}.

tcam acl (eth_srcAddr : 48, eth_dstAddr : 48, ipv4_srcAddr : 32, ipv4_dstAddr : 32) : {} [drop nop]
o--
    ad_punt >>
    delete key etherType >>
    delete key isValid >>
    delete key version >>
    delete key ttl >>
    key ipv4_srcAddr := srcAddr >>
    key ipv4_dstAddr := dstAddr >>
    delete key srcAddr >>
    delete key dstAddr >>
    ignore key eth_srcAddr >>
    ignore key eth_dstAddr.
