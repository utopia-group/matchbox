tcam ipv4_fib (dstAddr : 32) : {port : 9} [fwd nop].
tcam ipv4_rewrite (dstAddr : 32) : {dstAddr : 48} [rewrite nop].
tcam ad_ethernet (dstAddr : 48) : {port : 9} [fwd nop].
tcam ad_punt (etherType : 16, isValid : 1, version : 4, srcAddr : 32, dstAddr : 32, ttl : 8) : {} [drop nop].

tcam staging (ingress_port : 9) : {c : 4} [set_choice skip_pipe]
o--
    |0b********* -> set_choice(0b0011)|.

tcam ch_ipv4 (dstAddr : 32) : {dstAddr : 48, port : 9} [fwd nop]
o--
    ipv4_fib * ipv4_rewrite >>
    rename fwd;rewrite to fwd >>
    rename fwd;nop to nop >>
    rename rewrite;nop to nop >>
    rename nop;rewrite to nop >>
    rename nop;nop to nop.

tcam ch_ipv42 (dstAddr : 32) : {dstAddr : 48, port : 9} [fwd nop]
o--
    ch_ipv4.

tcam ch_ethernet (dstAddr : 48) : {port : 9} [fwd nop]
o--
    ad_ethernet.

tcam ch_ethernet2 (dstAddr : 48) : {port : 9} [fwd nop]
o--
    ad_ethernet.

tcam ch_punt (etherType : 16, isValid : 1, version : 4, srcAddr : 32, dstAddr : 32, ttl : 8) : {} [drop nop]
o--
    ad_punt.

tcam ch_punt2 (etherType : 16, isValid : 1, version : 4, srcAddr : 32, dstAddr : 32, ttl : 8) : {} [drop nop]
o--
    ad_punt.
