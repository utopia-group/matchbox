tcam acl (
    is_inbound : 1,
    srcAddr : 32,
    dstAddr : 32,
    proto : 8,
    l4_sport : 16,
    l4_dport : 16
) : {} [allow deny].
tcam ipv4_state (
    is_inbound : 1,
    srcAddr : 32,
    dstAddr : 32,
    proto : 8,
    l4_sport : 16,
    l4_dport : 16
) : {} [seen unseen].

assume acl : {
    srcAddr : 32,
    proto : 8,
    l4_sport : 16
    | true && is_inbound & 1[1] == 1[0] & 1[1] && true
} ---> {}.

tcam inbound_acl (
    srcAddr : 32,
    proto : 8,
    l4_sport : 16
) : {} [allow deny]
o--
    acl >>
    cube_filter {
        is_inbound -> 0b0
    } >>
    delete key is_inbound >>
    delete key dstAddr >>
    delete key l4_dport.

assume acl : {
    dstAddr : 32,
    proto : 8,
    l4_dport : 16
    | true && is_inbound & 1[1] == 1[1] & 1[1] && true
} ---> {}.

tcam outbound_acl (
    dstAddr : 32,
    proto : 8,
    l4_dport : 16
) : {} [allow deny]
o--
    acl >>
    cube_filter {
        is_inbound -> 0b1
    } >>
    delete key is_inbound >>
    delete key srcAddr >>
    delete key l4_sport.

tcam aws_ipv4_state (
    is_inbound : 1,
    srcAddr : 32,
    dstAddr : 32,
    proto : 8,
    l4_sport : 16,
    l4_dport : 16
) : {} [seen unseen]
o--
    ipv4_state.
