tcam port_forward (ip_mask : 32, cpu_id : 5) : {src_port : 16, dst_port : 16} [forward nop].

assume port_forward : {
    ip_mask : 32
    | true && cpu_id & 5[31] == 5[0] & 5[31] && true
} ---> {src_port : 16, dst_port : 16}.

tcam port_forward0 (ip_mask : 32) : {src_port : 16, dst_port : 16} [forward nop]
o--
    port_forward >>
    cube_filter {
        cpu_id -> 5[0]
    } >>
    delete key cpu_id.

