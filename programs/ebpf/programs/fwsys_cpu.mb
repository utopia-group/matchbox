tcam acl (ip_mask : 32, cpu_id : 5) : {} [allow deny].

assume acl : {
    ip_mask : 32
    | true && cpu_id & 5[31] == 5[0] & 5[31] && true
} ---> {}.

tcam acl0 (ip_mask : 32) : {} [allow deny]
o--
    acl >>
    cube_filter {
        cpu_id -> 5[0]
    } >>
    delete key cpu_id.

assume acl : {
    ip_mask : 32
    | true && cpu_id & 5[31] == 5[1] & 5[31] && true
