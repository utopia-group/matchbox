tcam rate_limit (ip_mask : 32, cpu_id : 5) : {limit : 8} [limit nop].

assume rate_limit : {
    | true && cpu_id & 5[31] == 5[0] & 5[31] && true
} ---> {limit : 8}.

tcam rate_limit0 (ip_mask : 32) : {limit : 8} [limit nop]
o--
    rate_limit >>
    cube_filter {
        cpu_id -> 5[0]
    } >>
    delete key cpu_id.

assume rate_limit : {
    | true && cpu_id & 5[31] == 5[1] & 5[31] && true
} ---> {limit : 8}.

