(assert (forall ((x (_ BitVec 3)) (action (_ BitVec 2)))
    (= 
        (  if (= x #b000) (= action #b00)
         ( if (= x #b001) (= action #b00)
           (= action #b10)))    
        (if (= (bvand x #b010) (bvand #b010 #b010)) (= action #b10)
         ( if (= (bvand x #b100) (bvand #b000 #b100)) (= action #b00)
          (= action #b10)
        ))
    )
))
(minimize ?m)
(check-sat)
(get-value (?v ?m ?a))