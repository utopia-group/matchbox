; synthesizer_tests and surface_synthesizer_tests target an extinct API
; (Clause.Invert, ActionTfx, BaseSynthesizer.synth); they are intentionally
; not listed so they can never be force-compiled. The files remain on disk
; for reference. The live synthesizer suite is synth_tests below.
(test
 (name matchbox_test)
 (libraries matchbox gpl alcotest core)
 (modules
  matchbox_test
  controller_tests
  interpreter_tests
  surface_interpreter_tests
  classbench_parsing_tests
  acl_translation_tests)
 (action
  (run %{exe:matchbox_test.exe} --verbose)))

